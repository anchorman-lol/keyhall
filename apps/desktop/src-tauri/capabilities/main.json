{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The launcher window: key setup, game windows and the monthly budget. Game windows get their own capability at runtime.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "allow-key-status",
    "allow-generate-key",
    "allow-import-key",
    "allow-open-game",
    "allow-check-game",
    "allow-close-game",
    "allow-answer-sign-request",
    "allow-sign-event",
    "allow-nip44-encrypt",
    "allow-nip44-decrypt",
    "allow-wallet-status",
    "allow-connect-wallet",
    "allow-wallet-pay-request",
    "allow-wallet-pay-result",
    "allow-play-sessions",
    "allow-sign-label",
    "allow-restart-to-update"
  ]
}
